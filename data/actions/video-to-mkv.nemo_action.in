[Nemo Action]
Name=Convert to MKV without re-encoding
Name[es]=Pasar a MKV sin recodificar
Comment=Create an MKV copy without losing quality
Comment[es]=Crea una copia MKV sin perder calidad
Icon-Name=video-x-generic-symbolic
Exec=@media_tools_path@ video-to-mkv %F
Group=Video
Group[es]=Vídeo
Section=conversion
Position=10
Selection=Any
Mimetypes=video/*;
Dependencies=python3;ffmpeg;
