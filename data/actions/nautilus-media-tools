def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=tr(
            "Create new media files without overwriting the originals.",
            "Crea nuevos archivos multimedia sin sobrescribir los originales.",
        )
    )
    parser.add_argument("operation", choices=OPERATIONS)
    parser.add_argument(
        "--value",
        default=os.environ.get("DORI_PROMPT"),
        help=tr("answer to the action's prompt", "respuesta al diálogo de la acción"),
    )
    parser.add_argument("files", nargs="+", help=tr("input files", "archivos de entrada"))
    return parser.parse_args()


def main() -> int:
    global PROMPT_VALUE

    arguments = parse_arguments()
    PROMPT_VALUE = arguments.value
    operation = OPERATIONS[arguments.operation]
    notify(
        tr("Media operation started", "Operación multimedia iniciada"),
        tr("The new files will appear in the same folder.", "Los archivos nuevos aparecerán en la misma carpeta."),
    )

    try:
        result = operation(arguments.files)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        detail = str(error) if isinstance(error, ValueError) else tr(
            "The original files have not been modified.",
            "Los archivos originales no se han modificado.",
        )
        notify(tr("The operation could not be completed", "No se pudo completar la operación"), detail, error=True)
        return 1

    outcome = result if isinstance(result, Outcome) else Outcome(result)
    if outcome.message is not None:
        message = outcome.message
    elif len(outcome.paths) == 1:
        message = tr(f"Created {outcome.paths[0].name}", f"Se ha creado {outcome.paths[0].name}")
    else:
        message = tr(f"Created {len(outcome.paths)} files", f"Se han creado {len(outcome.paths)} archivos")
    notify(tr("Operation completed", "Operación completada"), message)
    return 0


if __name__ == "__main__":
    sys.exit(main())
