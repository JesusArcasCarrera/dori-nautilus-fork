using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  search-enabled: true;

  Adw.PreferencesPage {
    title: _("General");

    Adw.PreferencesGroup {
      title: _("General");

      Adw.SwitchRow sort_folders_first_row {
        title: _("Sort _Folders Before Files");
        use-underline: true;
      }

      Adw.SwitchRow use_tree_view_row {
        title: _("_Expandable Folders in List View");
        use-underline: true;
      }

      Adw.ComboRow open_action_row {
        title: _("_Action to Open Items");
        use-underline: true;
      }

      Adw.ComboRow type_to_action_row {
        title: _("When you _Start Typing");
        subtitle: _("Choose what plain typing does in a folder view. Ctrl+F and the search button always start a search.");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Optional Context Menu Actions");
      description: _(
        "Show more actions in the menus. Keyboard shortcuts can be used even if the actions are not shown."
      );

      Adw.SwitchRow show_create_link_row {
        title: _("Create _Link");
        use-underline: true;
      }

      Adw.SwitchRow show_delete_permanently_row {
        title: _("_Delete Permanently");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Performance");
      description: _(
        "These features may cause slowdowns and excess network usage, especially when browsing files outside this device, such as on a remote server."
      );

      Adw.ComboRow search_recursive_row {
        title: _("Search in Su_bfolders");
        use-underline: true;
      }

      Adw.ComboRow thumbnails_row {
        title: _("Show _Thumbnails");
        use-underline: true;
      }

      Adw.ComboRow count_row {
        title: _("_Count Number of Files in Folders");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Date and Time Format");
      description: _("Choose how dates and times are displayed in list and grid views.");

      Adw.ActionRow date_format_simple_row {
        title: _("_Simple");
        use-underline: true;

        [prefix]
        CheckButton date_format_simple_button {
          valign: center;
          action-name: "preferences.date-time-format";
          action-target: "'simple'";
        }

        activatable-widget: date_format_simple_button;
      }

      Adw.ActionRow date_format_detailed_row {
        title: _("Deta_iled");
        use-underline: true;

        [prefix]
        CheckButton date_format_detailed_button {
          group: date_format_simple_button;
          valign: center;
          action-name: "preferences.date-time-format";
          action-target: "'detailed'";
        }

        activatable-widget: date_format_detailed_button;
      }
    }
  }

  Adw.PreferencesPage sidebar_page {
    title: _("Sidebar");
    icon-name: "view-sidebar-start-symbolic";

    Adw.PreferencesGroup {
      title: _("Built-in Items");
      description: _("Hide the default shortcuts you don’t use. Bookmarks and mounted drives are always shown.");

      Adw.SwitchRow sidebar_show_recent_row {
        title: _("_Recent");
        use-underline: true;
      }

      Adw.SwitchRow sidebar_show_starred_row {
        title: _("_Starred");
        use-underline: true;
      }

      Adw.SwitchRow sidebar_show_desktop_row {
        title: _("_Desktop");
        use-underline: true;
      }

      Adw.SwitchRow sidebar_show_network_row {
        title: _("_Network");
        use-underline: true;
      }

      Adw.SwitchRow sidebar_show_trash_row {
        title: _("_Trash");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Sections");
      description: _("Toggle entire sidebar sections at once.");

      Adw.SwitchRow sidebar_show_xdg_section_row {
        title: _("_User Folders");
        subtitle: _("Documents, Downloads, Music, Pictures, Videos, Public Share, Templates.");
        use-underline: true;
      }

      Adw.SwitchRow sidebar_show_cloud_row {
        title: _("_Cloud Providers");
        subtitle: _("Accounts exposed by installed cloud-provider integrations.");
        use-underline: true;
      }
    }
  }

  Adw.PreferencesPage custom_actions_page {
    title: _("Custom Actions");
    icon-name: "view-list-symbolic";

    Adw.PreferencesGroup custom_actions_group {
      title: _("Context Menu Actions");
      description: _("User-defined entries shown in the right-click menu. Action files live in ~/.local/share/nemo/actions/ as .nemo_action GKeyFiles (Cinnamon Nemo format). A built-in editor is coming; for now, files are edited by hand and reloaded automatically.");
    }
  }
}
