build/
.*/
!.gitlab/

# Ignore meson's subprojects folder
/subprojects

# Ignore auto generated files
/.buildconfig

# Ignore temporary files
*.orig
*~

# Ignore captures
/*.syscap
/heaptrack.nautilus.*

# MicroGit local actor config
.mgconfig

# Meson build dir
/_build

# Local scratch and backups (see user rules)
_tmp/
_backup_*/

# Generated Python caches
__pycache__/
*.py[cod]
